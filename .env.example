# Paste OPENROUTER_API_KEY in Vercel Project Settings -> Environment Variables (never commit real keys).
OPENROUTER_API_KEY=""

# Optional OpenRouter model overrides (defaults are configured in api/_lib/aiConfig.ts)
# OPENROUTER_SCAN_MODEL="google/gemini-2.5-flash"
# OPENROUTER_BILL_MODEL="google/gemini-2.5-flash-lite"
# OPENROUTER_VOICE_MODEL="google/gemini-2.5-flash-lite"
# OPENROUTER_TTS_MODEL="openai/gpt-audio-mini"

# Cloudinary public unsigned upload configuration (for bill photos, logos, signatures)
VITE_CLOUDINARY_CLOUD_NAME="dxeuzdwkz"
VITE_CLOUDINARY_UPLOAD_PRESET="Mobile app"

# Optional backend URL only if packaging static dist/ inside an offline Android WebView APK
# VITE_API_BASE_URL="https://your-vercel-app.vercel.app"
