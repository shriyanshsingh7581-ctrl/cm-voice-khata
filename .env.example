# OPENROUTER_API_KEY: Required for all OpenRouter AI API calls (Bill Scan, Digital Bill Gen, Voice & TTS).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# CLOUDINARY_CLOUD_NAME & UPLOAD_PRESET: Used for bill photo, logo, and signature uploads.
VITE_CLOUDINARY_CLOUD_NAME="dxeuzdwkz"
VITE_CLOUDINARY_UPLOAD_PRESET="Mobile app"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
